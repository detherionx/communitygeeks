# Communitygeeks site (cutover 28 Oct 2026). Generated by _build/production.py; edit there, not here.

# Canonical URL: https on the bare communitygeeks.ai host. Plain HTTP, www. and the legacy .de/.xyz/.net domains that
# share this docroot get a single-hop permanent redirect.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^communitygeeks\.ai$ [NC]
RewriteRule ^(.*)$ https://communitygeeks.ai/$1 [R=301,L]

# Security headers (carried over from the 2 Sep 2026 hardening pass). CSP stays report-only. Origins in use: self
# (pages, self-hosted fonts and images, inline bootstrap scripts), cloud.umami.is (analytics script) and
# gateway.umami.is (its beacon endpoint). Cal.com and LinkedIn are plain links, not embeds.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), midi=(), fullscreen=()"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloud.umami.is https://gateway.umami.is; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# Retired routes of the previous site: shared review builds and the German landing.
RedirectMatch 301 ^/mockups/field/(.*)$ https://communitygeeks.ai/$1
RedirectMatch 301 ^/mockups/home/?(.*)$ https://communitygeeks.ai/
RedirectMatch 302 ^/mockups/ https://communitygeeks.ai/
RedirectMatch 301 ^/de/?$ https://communitygeeks.ai/de/research/articles/

# Research URL move (28 Oct 2026). Articles keep one permanent URL at /research/<slug>/ (German: /de/research/<slug>/).
# Explicit rules only: no catch-all, because the former /public-thinking/builder-ecosystems/
# article (The End of the Line) must not land on the new /research/builder-ecosystems/ track page.
RedirectMatch 301 ^/public-thinking/?$ https://communitygeeks.ai/research/articles/
RedirectMatch 301 ^/public-thinking/builder-ecosystems/?$ https://communitygeeks.ai/research/the-end-of-the-line/
