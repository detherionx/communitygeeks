# Routes from the restructure (HANDOFF v3): the builder offer moved under /services/, Bilbao points at Uncopyable.
RedirectMatch 301 ^/programmes/terms/?$ https://communitygeeks.ai/services/builder-programmes/terms/
RedirectMatch 301 ^/programmes/?$ https://communitygeeks.ai/services/builder-programmes/
RedirectMatch 302 ^/bilbao/?$ https://communitygeeks.ai/uncopyable/?utm_source=big&utm_medium=event

# Legacy page routes that pointed at homepage chapters which no longer exist in the new design.
RedirectMatch 301 ^/contact/?$ https://communitygeeks.ai/#contact
