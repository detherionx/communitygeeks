---
layout: layouts/pt.njk
lang: en
pagination:
  data: publicThinking
  size: 1
  alias: piece
  addAllPagesToCollections: true
permalink: "{{ piece.url }}"
navActive: pt
eleventyComputed:
  title: "{{ piece.title | safe }}"
  description: "{{ piece.summary | safe }}"
  ogImage: "{{ piece.ogImage }}"
  ogImageAlt: "{{ piece.title | safe }} · Communitygeeks"
  extraHead:
    - "{{ piece.articleJsonLd | safe }}"
    - "{% if piece.translations.de %}<link rel='alternate' hreflang='en' href='https://communitygeeks.ai{{ piece.url }}'><link rel='alternate' hreflang='de' href='https://communitygeeks.ai{{ piece.translations.de }}'><link rel='alternate' hreflang='x-default' href='https://communitygeeks.ai{{ piece.url }}'>{% endif %}"
extraScripts:
  - "figure-lightbox.js"
---
{# ARTICLE (EN) inside the concept shell: the live item.njk composition,
   verbatim (kicker, masthead, side panel, body, closing field, author box),
   with only a breadcrumb added and internal Public Thinking links pointed
   at the concept routes. No motion, no diagrams: reading stays quiet. #}
{% from "partials/geo-plate.njk" import geoPlate %}
{% from "partials/pt-motifs.njk" import ptConstellation %}
<article class="pt-article" data-artifact-slug="{{ piece.slug }}" data-artifact-lang="{{ piece.lang }}" data-artifact-translation-key="{{ piece.translationKey }}" data-artifact-format="{{ piece.format }}" data-artifact-confidence="{{ piece.confidence }}">
  <div class="wrap pt-article-wrap">
    <div class="pt-topbar">
      <div class="pt-kicker">
        {% include "partials/node-mark.njk" %}
        <nav class="pt-crumb pt-crumb-inline" aria-label="Breadcrumb"><a href="/public-thinking/">Public Thinking</a><span aria-hidden="true">&middot;</span><span>{{ piece.format }}</span></nav>
      </div>
      {% if piece.translations.de %}
      <div class="pt-lang-switch">
        <span class="active" aria-current="page">EN</span> <a href="{{ piece.translations.de }}" hreflang="de" lang="de">DE</a>
      </div>
      {% endif %}
    </div>

    {% set hasSide = (piece.topics and piece.topics.length) or piece.openQuestion or piece.motif %}
    <header class="pt-masthead{% if not hasSide %} pt-masthead-solo{% endif %}">
      <div class="pt-masthead-main">
        <div class="pt-masthead-content">
          {% if piece.obs %}<p class="obs-label"><b>OBS. {{ piece.obs }}</b> · {{ piece.date | readableDate }} · transferred from the field</p>{% endif %}
          <h1 class="pt-title">{{ piece.title }}</h1>
          {% if piece.deck %}<p class="pt-deck">{{ piece.deck }}</p>{% endif %}
          <div class="pt-meta">
            <span class="pt-meta-confidence">{{ piece.confidence }}</span>
            <span>{{ piece.date | readableDate }}</span>
            <span>{% for name in piece.authors %}{{ name }}{% if not loop.last %} &amp; {% endif %}{% endfor %}</span>
          </div>
          {% if piece.pdf %}<p class="pt-pdf-link"><a href="{{ piece.pdf }}">Download PDF →</a></p>{% endif %}
        </div>
      </div>
      {% if hasSide %}
      <div class="pt-masthead-side accent-{{ piece.accentColor or 'petrol' }}">
        {# the observation transferred into the journal: the piece's constellation heads the notation column #}
        {% if piece.motif %}<div class="pt-motif pt-motif--spec pt-motif-{{ piece.motif }}">{{ ptConstellation(piece.motif, 'masthead', 'paper', 'en') }}</div>
        {# phones: the simplified catalogue drawing replaces the detailed specimen (CSS toggles the two) #}
        <div class="pt-motif pt-motif--spec-mobile pt-motif-{{ piece.motif }}" aria-hidden="true">{{ ptConstellation(piece.motif, 'catalogue', 'paper') }}</div>{% endif %}
        {% if piece.topics and piece.topics.length %}
        <span class="pt-side-label">Topics</span>
        <div class="pt-side-tags">
          {% for topic in piece.topics %}<span class="pt-side-tag">{{ topic }}</span>{% endfor %}
        </div>
        {% endif %}
        {% if piece.openQuestion %}<p class="pt-side-oq">&ldquo;{{ piece.openQuestion }}&rdquo;</p>{% endif %}
      </div>
      {% endif %}
    </header>

    <div class="pt-body">
      {{ piece.contentHtml | safe }}
    </div>

    <div class="pt-closing-field">
      {% if piece.geometry and piece.geometry.shapes %}
      {{ geoPlate(shapes=piece.geometry.shapes, viewBox=piece.geometry.viewBox or "0 0 300 300", extraClass="pt-field-geo") }}
      {% endif %}
      <footer class="pt-closing">
        {% if piece.openQuestion %}
        <p class="pt-closing-question">{{ piece.openQuestion }}</p>
        {% endif %}
        <p class="pt-closing-thread">Part of our ongoing research into {{ piece.researchThread or "how participation is organized around companies" }}.</p>

        {% if piece.related and piece.related.length %}
        <ul class="pt-related-list">
          {% for rel in piece.related %}
          <li><a href="/public-thinking/{{ rel.slug }}/">{{ rel.title }} →</a></li>
          {% endfor %}
        </ul>
        {% endif %}

        <p class="pt-closing-invite">See it differently? <a href="/contact/">We'd like to hear it →</a></p>
      </footer>
    </div>

    {% for name in piece.authors %}
    {% set person = people[name] %}
    <div class="pt-author-box">
      {% if person and person.image %}<img src="{{ person.image }}" alt="" class="pt-author-photo">{% endif %}
      <div>
        <div class="pt-author-name">{% if person and person.url %}<a href="{{ person.url }}">{{ name }}</a>{% else %}{{ name }}{% endif %}</div>
        {% if person and person.role %}<div class="pt-author-role">{{ person.role }}</div>{% endif %}
        {% if person and person.bio %}<p class="pt-author-bio">{{ person.bio }}</p>{% endif %}
        <div class="pt-author-links"><a href="/about/">About</a> &middot; {% if person and person.sameAs and person.sameAs.length %}<a href="{{ person.sameAs[0] }}">LinkedIn</a> &middot; {% endif %}<a href="/public-thinking/">More Public Thinking</a></div>
      </div>
    </div>
    {% endfor %}
  </div>
</article>
