---
layout: layouts/base.njk
lang: de
pagination:
  data: publicThinkingDe
  size: 1
  alias: piece
  addAllPagesToCollections: true
permalink: "{{ piece.url }}"
eleventyComputed:
  title: "{{ piece.title | safe }}"
  description: "{{ piece.summary | safe }}"
  extraHead:
    - "{{ piece.articleJsonLd | safe }}"
    - "{% if piece.translations.en %}<link rel='alternate' hreflang='de' href='https://communitygeeks.ai{{ piece.url }}'><link rel='alternate' hreflang='en' href='https://communitygeeks.ai{{ piece.translations.en }}'><link rel='alternate' hreflang='x-default' href='https://communitygeeks.ai{{ piece.translations.en }}'>{% endif %}"
extraScripts:
  - "figure-lightbox.js"
---
{% from "partials/geo-plate.njk" import geoPlate %}
<article class="pt-article" data-artifact-slug="{{ piece.slug }}" data-artifact-lang="{{ piece.lang }}" data-artifact-translation-key="{{ piece.translationKey }}" data-artifact-format="{{ piece.format }}" data-artifact-confidence="{{ piece.confidence }}">
  <div class="wrap pt-article-wrap">
    <div class="pt-topbar">
      <div class="pt-kicker">
        {% include "partials/node-mark.njk" %}
        <span>Public Thinking &middot; {{ piece.format }}</span>
      </div>
      {% if piece.translations.en %}
      <div class="pt-lang-switch">
        <a href="{{ piece.translations.en }}">EN</a> <span class="active">DE</span>
      </div>
      {% endif %}
    </div>

    {% set hasSide = (piece.topics and piece.topics.length) or piece.openQuestion %}
    <header class="pt-masthead{% if not hasSide %} pt-masthead-solo{% endif %}">
      <div class="pt-masthead-main">
        <h1 class="pt-title">{{ piece.title }}</h1>
        {% if piece.deck %}<p class="pt-deck">{{ piece.deck }}</p>{% endif %}
        <div class="pt-meta">
          <span class="pt-meta-confidence">{{ piece.confidence }}</span>
          <span>{{ piece.date | readableDate("de") }}</span>
          <span>{% for name in piece.authors %}{{ name }}{% if not loop.last %} &amp; {% endif %}{% endfor %}</span>
        </div>
        {% if piece.pdf %}<p class="pt-pdf-link"><a href="{{ piece.pdf }}">PDF herunterladen →</a></p>{% endif %}
      </div>
      {% if hasSide %}
      <div class="pt-masthead-side accent-{{ piece.accentColor or 'petrol' }}">
        {% if piece.topics and piece.topics.length %}
        <span class="pt-side-label">Themen</span>
        <div class="pt-side-tags">
          {% for topic in piece.topics %}<span class="pt-side-tag">{{ topic }}</span>{% endfor %}
        </div>
        {% endif %}
        {% if piece.openQuestion %}<p class="pt-side-oq">&bdquo;{{ piece.openQuestion }}&ldquo;</p>{% endif %}
      </div>
      {% endif %}
    </header>

    <div class="pt-body-field">
      {% if piece.geometry and piece.geometry.shapes %}
      {{ geoPlate(shapes=piece.geometry.shapes, viewBox=piece.geometry.viewBox or "0 0 300 300", extraClass="pt-field-geo") }}
      {% endif %}
      <div class="pt-body">
        {{ piece.contentHtml | safe }}
      </div>
    </div>

    <footer class="pt-closing">
      {% if piece.openQuestion %}
      <p class="pt-closing-question">{{ piece.openQuestion }}</p>
      {% endif %}
      <p class="pt-closing-thread">Teil unserer laufenden Recherche zu {{ piece.researchThread or "Teilhabe rund um Unternehmen" }}.</p>

      {% if piece.related and piece.related.length %}
      <ul class="pt-related-list">
        {% for rel in piece.related %}
        <li><a href="/de/public-thinking/{{ rel.slug }}/">{{ rel.title }} →</a></li>
        {% endfor %}
      </ul>
      {% endif %}

      <p class="pt-closing-invite">Sehen Sie das anders? <a href="/contact/">Wir würden es gerne hören →</a></p>
    </footer>

    {% for name in piece.authors %}
    {% set person = people[name] %}
    <div class="pt-author-box">
      {% if person and person.image %}<img src="{{ person.image }}" alt="" class="pt-author-photo">{% endif %}
      <div>
        <div class="pt-author-name">{% if person and person.url %}<a href="{{ person.url }}">{{ name }}</a>{% else %}{{ name }}{% endif %}</div>
        {% if person and person.role %}<div class="pt-author-role">{{ person.role }}</div>{% endif %}
        {% if person and person.bioDe %}<p class="pt-author-bio">{{ person.bioDe }}</p>{% endif %}
        <div class="pt-author-links"><a href="/about/">Mehr über {{ name }}</a> &middot; {% if person and person.sameAs and person.sameAs.length %}<a href="{{ person.sameAs[0] }}">LinkedIn</a> &middot; {% endif %}<a href="/de/public-thinking/">Weitere Public Thinking-Beiträge</a></div>
      </div>
    </div>
    {% endfor %}
  </div>
</article>
