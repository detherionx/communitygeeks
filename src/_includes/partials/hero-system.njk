{# v63 hero: one organisation, one orbit carrying the three outcomes, one slow outer arc, three spokes, three astronauts.
   Shape encodes the group everywhere on the page: circle = community and customers, square = developers,
   triangle = partners. The composition carries the meaning, so there is no legend, numbering, ties or satellites. #}
{% from "partials/participation-scenes.njk" import robot %}
<svg class="system-art" viewBox="0 0 760 640" role="img" aria-labelledby="system-title system-desc">
  <title id="system-title">People connect across teams and channels</title>
  <desc id="system-desc">An organisation at the centre with three outcomes on its orbit: customers and community members come back, developers bring an integration live and partners open new routes to market.</desc>
  <defs>
    <radialGradient id="system-glow" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(210 360) scale(420)">
      <stop offset="0" stop-color="#2B5C5B" stop-opacity=".45"/><stop offset="1" stop-color="#2B5C5B" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <circle cx="210" cy="360" r="420" fill="url(#system-glow)"/>
  <g class="system-rings" fill="none">
    <circle cx="210" cy="360" r="300" class="ring-main"/>
    <g class="drift-b ring-drift"><path class="ring-arc" d="M357 -44 A430 430 0 0 1 562 607"/></g>
  </g>

  <g class="system-spokes">
    <path class="spoke" pathLength="1" d="M296 277 L366 180"/>
    <path class="spoke" pathLength="1" d="M330 360 L470 360"/>
    <path class="spoke" pathLength="1" d="M296 444 L366 538"/>
  </g>

  <g class="system-core">
    <circle cx="210" cy="360" r="114" class="core-disc"/>
    <rect x="156" y="306" width="108" height="108" class="core-square"/>
    <path class="core-team" d="M176 334h68"/><path class="core-team" d="M176 356h44"/><path class="core-team" d="M176 378h56"/>
    <circle cx="244" cy="394" r="5" class="core-dot"/>
  </g>
  <text class="system-caption" x="210" y="512" text-anchor="middle">YOUR ORGANISATION</text>

  <g class="system-node node-people"><circle cx="426" cy="152" r="34"/></g>
  <g class="system-node node-dev"><rect x="476" y="326" width="68" height="68"/></g>
  <g class="system-node node-partner"><path d="M426 526 470 602H382Z"/></g>

  <g class="system-crew">
    {{ robot('system',520,206,'returner','walk',128,-1,true) }}
    {{ robot('system',640,468,'engineer','connect',168,1,true) }}
    {{ robot('system',612,664,'crew','handoff',176) }}
  </g>
</svg>
