{# STAGED VARIANT of ecosystem-diagram.njk for the homepage mockup's pinned
   scroll sequence. Identical geometry, labels, colours and semantics to the
   approved Concept B diagram (see HANDOFF.md §25/§26): the only difference
   is markup hooks (wrapper <g> elements with class/--n) so CSS can reveal
   the five identical participant fields in sequence and deepen their fill
   at the final step. Nothing is added to what the diagram claims: every
   field still straddles the product by the same amount, and all five end
   in exactly the same visual state. #}
<svg class="ecosystem-diagram eco-staged" viewBox="0 0 840 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Diagram showing five equally-weighted, overlapping participant-group fields: users, developers, creators, partners, and advocates, each intersecting a shared product band by the same amount, and overlapping one another, illustrating one connected participation system rather than five independent audiences.">
  <g class="eco-fields" stroke="#1B1912" stroke-width="2">
    <g class="eco-field" style="--n:0"><rect x="35" y="170" width="190" height="210" transform="rotate(-3 130 275)"/></g>
    <g class="eco-field" style="--n:1"><rect x="175" y="170" width="190" height="210" transform="rotate(2 270 275)"/></g>
    <g class="eco-field" style="--n:2"><rect x="320" y="170" width="190" height="210" transform="rotate(-2 415 275)"/></g>
    <g class="eco-field" style="--n:3"><rect x="470" y="170" width="190" height="210" transform="rotate(3 565 275)"/></g>
    <g class="eco-field" style="--n:4"><rect x="615" y="170" width="190" height="210" transform="rotate(-4 710 275)"/></g>
  </g>

  <g class="eco-product">
    <rect x="40" y="210" width="760" height="130" fill="#1B1912"/>
    <rect x="40" y="210" width="8" height="130" fill="#B08D57"/>
    <text class="ed-title" x="420" y="268" text-anchor="middle" font-weight="700" font-size="18" letter-spacing="0.01em" fill="#F6F4EF">YOUR PRODUCT</text>
    <text class="eco-product-sub" x="420" y="292" text-anchor="middle" font-size="11" fill="#F6F4EF" letter-spacing="0.06em">PARTICIPATION SYSTEM</text>
  </g>

  <g class="eco-labels" font-weight="700" font-size="15" letter-spacing="0.02em" fill="#1B1912" text-anchor="middle">
    <text class="ed-title eco-label" style="--n:0" x="130" y="110">USERS</text>
    <text class="ed-title eco-label" style="--n:1" x="270" y="110">DEVELOPERS</text>
    <text class="ed-title eco-label" style="--n:2" x="415" y="110">CREATORS</text>
    <text class="ed-title eco-label" style="--n:3" x="565" y="110">PARTNERS</text>
    <text class="ed-title eco-label" style="--n:4" x="710" y="110">ADVOCATES</text>
  </g>
  <g class="eco-descs" font-size="9.5" fill="#4A473E" text-anchor="middle">
    <text class="eco-label" style="--n:0" x="130" y="130">adoption &#183; usage</text>
    <text class="eco-label" style="--n:1" x="270" y="130">integrations &#183; tooling</text>
    <text class="eco-label" style="--n:2" x="415" y="130">content &#183; education</text>
    <text class="eco-label" style="--n:3" x="565" y="130">distribution &#183; services</text>
    <text class="eco-label" style="--n:4" x="710" y="130">trust &#183; referrals</text>
  </g>
</svg>
