{% from "partials/pt-motifs.njk" import ptConstellation %}
{# Same card as partials/pt-card.njk (structure, classes, copy untouched),
   with a `base` prefix (kept from the review build; production passes ""). #}
{% macro ptCardBase(piece, index, headingLevel, lang, base) %}
{% set lang = lang or "en" %}
<article class="pt-card accent-{{ piece.accentColor or 'petrol' }}" data-type="{{ piece.filterType }}">
  <div class="pt-card-field"></div>
  {# catalogue entry: the piece's constellation as a specimen glyph, with its persistent observation number #}
  {% if piece.motif %}<div class="pt-motif pt-motif--card pt-motif-{{ piece.motif }}" aria-hidden="true">{{ ptConstellation(piece.motif, 'catalogue', 'paper') }}</div>{% endif %}
  {% if piece.obs %}<span class="cat-no">OBS. {{ piece.obs }}</span>{% endif %}
  <div class="pt-card-inner">
    <div class="pt-card-meta">
      <span class="pt-format">{{ piece.format }}</span>
      <span class="pt-meta-confidence">{{ piece.confidence }}</span>
    </div>
    <h{{ headingLevel }} class="pt-card-title"><a href="{{ base }}{{ piece.url }}">{{ piece.title }}</a></h{{ headingLevel }}>
    {% if piece.deck %}<p class="pt-card-deck">{{ piece.deck }}</p>{% endif %}
    {% if piece.topics and piece.topics.length %}
    <div class="pt-card-tags">
      {% for topic in piece.topics %}<span class="pt-card-tag">{{ topic }}</span>{% endfor %}
    </div>
    {% endif %}
    <div class="pt-card-foot">
      <span>{{ piece.date | readableDate(lang) }}</span>
      {% if lang == "de" %}
      <a href="{{ base }}{{ piece.url }}">{{ piece.format }} lesen →</a>
      {% else %}
      <a href="{{ base }}{{ piece.url }}">Read {{ piece.format | lower }} →</a>
      {% endif %}
    </div>
  </div>
</article>
{% endmacro %}
