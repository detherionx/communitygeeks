{# One piece's editorial watermark — a restrained Bauhaus motif derived from
   its subject, not a thumbnail or a network diagram. This macro returns
   only the bare SVG; every context that uses it (.pt-card on the homepage
   rail/archive grid, the article hero) wraps it in its own .pt-motif--card
   / .pt-motif--hero container with its own position/scale/opacity in
   style.css. The SVG itself is never duplicated per context.

   Extending this — two cases:
   - A new piece reusing an existing motif slug: frontmatter-only change,
     nothing here or in style.css needs to move.
   - A genuinely new motif design: add a new {% elif motif == "your-slug" %}
     branch below, then add .pt-motif-your-slug rules (under both
     .pt-motif--card and .pt-motif--hero, if the shared default needs
     tuning for it) in style.css. #}
{% macro ptMotif(motif) %}
{% if motif == "gaming" %}
<svg viewBox="0 0 300 220" xmlns="http://www.w3.org/2000/svg">
  <rect x="30" y="70" width="240" height="110" rx="55" fill="var(--petrol)" />
  <rect x="70" y="108" width="14" height="42" fill="var(--paper)" />
  <rect x="55" y="123" width="44" height="14" fill="var(--paper)" />
  <circle cx="185" cy="102" r="16" fill="var(--brass)" />
  <circle cx="222" cy="132" r="20" fill="var(--paper)" />
  <circle cx="222" cy="132" r="20" fill="none" stroke="var(--brass)" stroke-width="3" />
</svg>
{% elif motif == "people-beyond-container" %}
<svg viewBox="0 0 300 240" xmlns="http://www.w3.org/2000/svg">
  <path d="M50 40 H190 M50 40 V190 M50 190 H190" fill="none" stroke="var(--ink)" stroke-width="3" />
  <circle cx="100" cy="95" r="12" fill="var(--petrol)" />
  <circle cx="115" cy="155" r="12" fill="var(--ink)" />
  <circle cx="250" cy="75" r="14" fill="var(--brass)" />
  <circle cx="255" cy="170" r="13" fill="var(--petrol)" />
  <line x1="115" y1="155" x2="250" y2="75" stroke="var(--ink)" stroke-width="2" />
  <line x1="100" y1="95" x2="255" y2="170" stroke="var(--ink)" stroke-width="2" />
</svg>
{% endif %}
{% endmacro %}
