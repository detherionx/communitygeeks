  </a>
  <button class="nav-toggle bar-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu"><span></span><span></span><span></span></button>
  <nav class="bar-nav nav-menu" id="nav-menu" aria-label="Primary">
    <a href="/#approach">Services</a>
    <a href="/#system">How we work</a>
    <a href="/public-thinking/"{% if navActive == 'pt' %} class="active" aria-current="page"{% endif %}>Articles</a>
    <a href="/about/"{% if navActive == 'about' %} class="active" aria-current="page"{% endif %}>About</a>
    <a href="/contact/" class="bar-cta"><span class="node-dot"></span>Let’s talk</a>
