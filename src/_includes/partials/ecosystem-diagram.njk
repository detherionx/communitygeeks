        <svg class="ecosystem-diagram" viewBox="0 0 840 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Diagram showing five equally-weighted, overlapping participant-group fields — users, developers, creators, partners, and advocates — each intersecting a shared product band by the same amount, and overlapping one another, illustrating one connected participation system rather than five independent audiences.">

          <!-- label zone (y 0–170) is kept entirely free of panel geometry,
               so names and descriptors never compete with the shapes below -->

          <!-- five participant groups: identical size and fill, each straddling
               the product band by the same fixed amount (equal intersection),
               and overlapping their neighbors (group-to-group intersection).
               Rotation is now subtle (2–4°) — a controlled skew, not a fold. -->
          <g fill="#1F4B4C" fill-opacity="0.14" stroke="#1B1912" stroke-width="2">
            <rect x="35" y="170" width="190" height="210" transform="rotate(-3 130 275)"/>
            <rect x="175" y="170" width="190" height="210" transform="rotate(2 270 275)"/>
            <rect x="320" y="170" width="190" height="210" transform="rotate(-2 415 275)"/>
            <rect x="470" y="170" width="190" height="210" transform="rotate(3 565 275)"/>
            <rect x="615" y="170" width="190" height="210" transform="rotate(-4 710 275)"/>
          </g>

          <!-- product: the one shared, privileged object every group overlaps
               by an identical amount — taller now, with real room for its type -->
          <rect x="40" y="210" width="760" height="130" fill="#1B1912"/>
          <rect x="40" y="210" width="8" height="130" fill="#B08D57"/>
          <text class="ed-title" x="420" y="268" text-anchor="middle" font-weight="700" font-size="18" letter-spacing="0.01em" fill="#F6F4EF">YOUR PRODUCT</text>
          <text x="420" y="292" text-anchor="middle" font-size="11" fill="#F6F4EF" opacity="0.65" letter-spacing="0.06em">PARTICIPATION SYSTEM</text>

          <!-- labels: fully clear of the panels beneath them, generous padding -->
          <g font-weight="700" font-size="15" letter-spacing="0.02em" fill="#1B1912" text-anchor="middle">
            <text class="ed-title" x="130" y="110">USERS</text>
            <text class="ed-title" x="270" y="110">DEVELOPERS</text>
            <text class="ed-title" x="415" y="110">CREATORS</text>
            <text class="ed-title" x="565" y="110">PARTNERS</text>
            <text class="ed-title" x="710" y="110">ADVOCATES</text>
          </g>
          <g font-size="9.5" fill="#4A473E" text-anchor="middle">
            <text x="130" y="130">adoption &#183; usage</text>
            <text x="270" y="130">integrations &#183; tooling</text>
            <text x="415" y="130">content &#183; education</text>
            <text x="565" y="130">distribution &#183; services</text>
            <text x="710" y="130">trust &#183; referrals</text>
          </g>
        </svg>
