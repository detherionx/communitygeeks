{# Canonical rear-projection crew. See CLAUDE.md. Square canvas, bottom-centre anchor; use dedicated reverse poses, never mirror the face. #}
{% macro robot(id,x,y,role='user',pose='walk',size=100,direction=1,flip=false) %}
<g transform="translate({{x}} {{y}})" data-actor="{{role}}" data-spacesuit data-actor-anchor{% if pose == 'connect' %} data-prop="safety-tether"{% elif pose == 'handoff' %} data-prop="toolkit"{% elif pose == 'carry' %} data-prop="finished-module"{% endif %}>
  <g data-crew-motion data-pose="{{pose}}" data-entry-direction="{{direction}}">
  <g class="crew-idle"><g><image class="crew-render" href="/assets/images/crew-rear-projection/{{pose}}{% if flip %}-flipped{% endif %}.webp" x="{{ -size / 2}}" y="{{ -size}}" width="{{size}}" height="{{size}}" preserveAspectRatio="xMidYMid meet" aria-hidden="true"/></g></g>
  </g>
</g>
{% endmacro %}

{% macro scene(id,kind) %}
{% set descriptions = {
 'growth':'People return, developers bring work into production and partners welcome new teams around an organisation. Dashed paths show how these activities can overlap.',
 'arrival':'A new user waits beside an unanswered help signal. Their first project remains unfinished.',
 'building':'An astronaut carries a completed integration module to a closed production airlock. Without an assigned reviewer, the module cannot enter production.',
 'paths':'A reviewer compares partner activity with an unanswered follow-up. Meetings and introductions are happening, but the next step is unclear.'
} %}
<div class="quiet-story" data-quiet-story="{{kind}}">
<svg class="participation-scene quiet-scene" viewBox="0 0 {{720 if kind == 'growth' else 480}} {{480 if kind == 'growth' else 320}}" role="img" aria-labelledby="{{id}}-title {{id}}-description">
{% set titles = {'growth':'Return, connect and get started','arrival':'Waiting for an answer','building':'A finished integration waits for review','paths':'Activity is not evidence of value'} %}
<title id="{{id}}-title">{{titles[kind]}}</title><desc id="{{id}}-description">{{descriptions[kind]}}</desc>
{% if kind == 'growth' %}
  <g data-prop="product"><path d="M42 151 62 132H239l20 19v168H42Z" fill="#739b8c"/><rect x="48" y="151" width="205" height="156" rx="5" fill="#dce4ce"/><rect x="58" y="163" width="185" height="134" rx="3" fill="#f2efde"/>
    <text x="150" y="187" text-anchor="middle" class="product-label">YOUR ORGANISATION</text><rect x="75" y="204" width="38" height="73" rx="3" fill="#729789"/><rect x="125" y="204" width="99" height="27" rx="3" fill="#d3dcc5"/><path d="M128 246h87m-87 13h64m-64 13h76" stroke="#9bb397" stroke-width="5"/><path d="M42 307H259l15 16H28Z" fill="#aabfa7"/>
  </g>
  <g stroke="#ea9b80" stroke-width="3" fill="none"><path d="M253 177h50V94h96"/><path d="M253 230H419"/><path d="M253 279h56v126h280"/></g>
  <g data-prop="cross-group-paths" stroke="#a9bea9" stroke-width="2" stroke-dasharray="5 7" fill="none"><path d="M548 140c35 24 46 42 48 69"/><path d="M583 272c-30 23-50 49-57 85"/></g>
  <text x="401" y="48" class="growth-outcome">People come back.</text>
  <g data-prop="repeat-use"><rect x="403" y="73" width="147" height="69" rx="5" fill="#739b8c" data-scenery-plane/><rect x="399" y="69" width="147" height="69" rx="5" fill="#f3efe4" stroke="#123a3e" stroke-width="1.2"/><path d="M414 87h116" stroke="#8ca992" stroke-width="4"/><rect x="414" y="101" width="27" height="21" rx="3" fill="#729886"/><rect x="451" y="101" width="27" height="21" rx="3" fill="#729886"/><rect x="488" y="101" width="39" height="21" rx="3" fill="#e49a7d"/>
    <g>{{ robot(id,608,153,'returner','walk',110) }}</g><path d="M570 135H551m10-8-10 8 10 8" stroke="#eaa184" stroke-width="3" fill="none"/>
  </g>
  <text x="401" y="189" class="growth-outcome">Integrations go live.</text>
  <g data-prop="live-integration"><rect x="501" y="214" width="175" height="60" rx="5" fill="#739b8c" data-scenery-plane/><rect x="497" y="210" width="175" height="60" rx="5" fill="#f3efe4" stroke="#123a3e" stroke-width="1.2"/><text x="585" y="247" text-anchor="middle" class="product-label">PRODUCTION</text><rect x="485" y="223" width="14" height="32" rx="3" fill="#8fab97"/>
    <g>{{ robot(id,427,325,'engineer','connect',135) }}</g>
    <circle cx="653" cy="221" r="5" fill="#477b5f"/>
  </g>
  <text x="401" y="328" class="growth-outcome">Partners bring in teams.</text>
  <g data-prop="new-team"><g>{{ robot(id,546,480,'crew','handoff',145) }}</g></g>
  <g>{{ robot(id,153,478,'technician','inspect',174) }}</g>
{% elif kind == 'arrival' %}
  {# Constructed kit: 3px ink outline, flat fills, hard sage offset plates. Text stays live. #}
  <rect x="213" y="45" width="242" height="200" rx="6" fill="#5F8574" data-scenery-plane/><rect x="205" y="37" width="242" height="200" rx="6" fill="#F3EEDF" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/><text x="224" y="67" class="card-label">FIRST PROJECT</text>
  <rect x="224" y="84" width="204" height="62" rx="4" fill="#D8D5C3" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/><path d="M314 115h24m-12-12v24" stroke="#5F8574" stroke-width="4" stroke-linecap="round"/><text x="224" y="176" class="card-copy">Setup unfinished</text>
  <g><path d="M224 194h204" stroke="#123A3E" stroke-width="1.5" stroke-dasharray="3 5"/><text x="224" y="222" class="card-copy">Still no reply</text></g>
  <g data-prop="unanswered-signal" data-scene-motion="signal"><path d="M26 28H183V100H126l-17 17v-17H26Z" fill="#E9A084" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/><text x="104" y="59" text-anchor="middle" class="card-copy">Can anyone</text><text x="104" y="85" text-anchor="middle" class="card-copy">help?</text></g>
  <g data-prop="waiting-bench"><rect x="34" y="276" width="96" height="11" rx="3" fill="#8FAE9B" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/><path d="M46 287v24M118 287v24" stroke="#123A3E" stroke-width="7" stroke-linecap="round"/><path d="M46 287v24M118 287v24" stroke="#8FAE9B" stroke-width="3" stroke-linecap="round"/></g>
  {{ robot(id,104,309,'waiting-user','wait',186) }}
{% elif kind == 'building' %}
  {# Production threshold: a sealed sliding gate in the hull and an empty review console. #}
  <g data-prop="production-airlock">
    <rect x="252" y="-4" width="236" height="296" fill="#F3EEDF" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/>
    <path d="M252 26H488M252 262H488" stroke="#123A3E" stroke-width="1.5"/>
    <rect x="292" y="40" width="148" height="26" rx="3" fill="#F3EEDF" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/>
    <text x="366" y="58" text-anchor="middle" class="product-label" stroke="none">PRODUCTION</text>
    <rect x="296" y="80" width="140" height="176" rx="4" fill="#1F4B4C" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/>
    <g data-part="gate"><rect x="306" y="90" width="60" height="156" rx="2" fill="#8FAE9B" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/><rect x="366" y="90" width="60" height="156" rx="2" fill="#8FAE9B" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/>
    <path d="M318 110h36M378 110h36M318 226h36M378 226h36" stroke="#5F8574" stroke-width="4" stroke-linecap="round"/></g>
    <rect x="344" y="158" width="44" height="18" rx="3" fill="#D3A65F" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/><circle cx="366" cy="167" r="4" fill="#123A3E"/>
    <rect x="252" y="262" width="236" height="30" fill="#5F8574" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/>
    <g data-scene-motion="blocked">
      <rect x="258" y="170" width="30" height="62" rx="3" fill="#1F4B4C" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/>
      <rect x="264" y="178" width="18" height="18" rx="2" fill="#0E2F33"/>
      <circle cx="273" cy="208" r="5" fill="#E8735A"/>
      <text x="273" y="226" text-anchor="middle" class="micro-label" stroke="none" fill="#F3EEDF">REVIEW</text>
    </g>
  </g>
  <text x="27" y="49" class="card-label" style="fill:#e0e6ce">MODULE COMPLETE</text>
  {{ robot(id,128,300,'carrier','carry',212) }}
  <g><path d="M40 300H232" stroke="#E9A084" stroke-width="2.5" stroke-dasharray="4 6" stroke-linecap="round"/><text x="370" y="312" text-anchor="middle" class="scene-label">REVIEWER: UNASSIGNED</text></g>
{% else %}
  <g data-prop="activity-readout"><rect x="28" y="43" width="222" height="144" rx="6" fill="#5F8574" data-scenery-plane/><rect x="20" y="35" width="222" height="144" rx="6" fill="#F3EEDF" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/><text x="36" y="66" class="card-label">PARTNER ACTIVITY</text>
  {% for name in ['Meetings','Referrals','Introductions'] %}<g><text x="36" y="{{95 + loop.index0 * 30}}" class="table-label">{{name}}</text><rect x="162" y="{{83 + loop.index0 * 30}}" width="{{70-loop.index0*12}}" height="14" rx="2" fill="#8FAE9B" stroke="#123A3E" stroke-width="2"/></g>{% endfor %}</g>
  <g data-prop="outcome-monitor"><rect x="278" y="43" width="187" height="144" rx="6" fill="#5F8574" data-scenery-plane/><rect x="270" y="35" width="187" height="144" rx="6" fill="#F3EEDF" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/><text x="288" y="67" class="card-label">FOLLOW-UP</text><g data-scene-motion="signal"><text x="364" y="139" text-anchor="middle" class="code-mark">?</text></g></g>
  <g stroke="#123A3E" stroke-width="3" stroke-linejoin="round" fill="#8FAE9B"><rect x="124" y="179" width="12" height="20"/><rect x="358" y="179" width="12" height="20"/><rect x="104" y="197" width="52" height="8" rx="2"/><rect x="338" y="197" width="52" height="8" rx="2"/></g>
  {{ robot(id,251,318,'reviewer','compare',184) }}
  <path d="M23 255H135v35H23Z" fill="#E9A084" stroke="#123A3E" stroke-width="3" stroke-linejoin="round"/><text x="79" y="279" text-anchor="middle" class="table-label">FUND WHAT?</text>
{% endif %}
</svg>
<div class="quiet-story-control"></div>
</div>
{% endmacro %}
