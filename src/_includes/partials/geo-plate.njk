{#
  Reusable geometric-plate macro — the shared primitive vocabulary behind
  every secondary Bauhaus composition on the site (Approach, Field Notes).
  Deliberately NOT used by the homepage hero's geometric-field.njk, which
  is its own approved, locked composition — this macro is for everything
  that comes after it, so each new composition is a genuine variation on
  the same vocabulary rather than a copy of the hero or of each other.

  Call with a `shapes` array, e.g.:
    {{ geoPlate(shapes=[
      { type: "circle", cx: 90, cy: 100, r: 90, color: "petrol", opacity: 0.14 },
      { type: "rect", x: 0, y: 165, w: 300, h: 85, color: "ink", opacity: 0.06 },
      { type: "line", x1: 20, y1: 210, x2: 280, y2: 210, color: "brass", opacity: 0.3 }
    ], viewBox="0 0 300 260") }}

  Supported shape types: circle, semicircle (pass a raw `d` path), rect,
  triangle (pass `points`), line. Each shape's `color` must be one of
  petrol | brass | ink — no other values are wired to a fill/stroke.
#}
{% macro geoPlate(shapes, viewBox="0 0 300 300", extraClass="") %}
<svg class="geo-plate {{ extraClass }}" viewBox="{{ viewBox }}" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  {% for s in shapes %}
  {% if s.type == "circle" %}
  <circle cx="{{ s.cx }}" cy="{{ s.cy }}" r="{{ s.r }}" class="geo-{{ s.color }}" style="opacity:{{ s.opacity }}"{% if s.rotate %} transform="rotate({{ s.rotate }} {{ s.cx }} {{ s.cy }})"{% endif %}/>
  {% elif s.type == "semicircle" %}
  <path d="{{ s.d }}" class="geo-{{ s.color }}" style="opacity:{{ s.opacity }}"/>
  {% elif s.type == "rect" %}
  <rect x="{{ s.x }}" y="{{ s.y }}" width="{{ s.w }}" height="{{ s.h }}" class="geo-{{ s.color }}" style="opacity:{{ s.opacity }}"{% if s.rotate %} transform="rotate({{ s.rotate }} {{ s.x + s.w / 2 }} {{ s.y + s.h / 2 }})"{% endif %}/>
  {% elif s.type == "triangle" %}
  <polygon points="{{ s.points }}" class="geo-{{ s.color }}" style="opacity:{{ s.opacity }}"/>
  {% elif s.type == "line" %}
  <line x1="{{ s.x1 }}" y1="{{ s.y1 }}" x2="{{ s.x2 }}" y2="{{ s.y2 }}" class="geo-line-{{ s.color }}" style="opacity:{{ s.opacity }}"/>
  {% endif %}
  {% endfor %}
</svg>
{% endmacro %}
