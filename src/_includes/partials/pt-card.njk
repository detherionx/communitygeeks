{% macro ptCard(piece, index, headingLevel, lang) %}
{% set lang = lang or "en" %}
<article class="pt-card accent-{{ piece.accentColor or 'petrol' }}" data-type="{{ piece.filterType }}">
  <div class="pt-card-field"></div>
  <div class="pt-card-inner">
    {% set displayIndex = "0" ~ index if index < 10 else index %}
    <span class="pt-card-num" aria-hidden="true">{{ displayIndex }}</span>
    <div class="pt-card-meta">
      <span class="pt-format">{{ piece.format }}</span>
      <span class="pt-meta-confidence">{{ piece.confidence }}</span>
    </div>
    <h{{ headingLevel }} class="pt-card-title"><a href="{{ piece.url }}">{{ piece.title }}</a></h{{ headingLevel }}>
    {% if piece.deck %}<p class="pt-card-deck">{{ piece.deck }}</p>{% endif %}
    {% if piece.topics and piece.topics.length %}
    <div class="pt-card-tags">
      {% for topic in piece.topics %}<span class="pt-card-tag">{{ topic }}</span>{% endfor %}
    </div>
    {% endif %}
    <div class="pt-card-foot">
      <span>{{ piece.date | readableDate(lang) }}</span>
      {% if lang == "de" %}
      <a href="{{ piece.url }}">{{ piece.format }} lesen →</a>
      {% else %}
      <a href="{{ piece.url }}">Read {{ piece.format | lower }} →</a>
      {% endif %}
    </div>
  </div>
</article>
{% endmacro %}
