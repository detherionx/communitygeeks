<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} · Communitygeeks</title>
<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ ogTitle or (title ~ ' · Communitygeeks') }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="https://communitygeeks.ai{{ page.url }}">
<meta property="og:image" content="https://communitygeeks.ai/assets/images/communitygeeks-2-og-2026.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="627">
<meta property="og:image:type" content="image/png">
<meta property="og:image:alt" content="Communitygeeks 2.0. Participation has changed. We rebuilt the observatory. Deep teal field with the constellation Reticulum and a coral signal.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle or (title ~ ' · Communitygeeks') }}">
<meta name="twitter:description" content="{{ ogDescription or description }}">
<meta name="twitter:image" content="https://communitygeeks.ai/assets/images/communitygeeks-2-og-2026.png">
<meta name="twitter:image:alt" content="Communitygeeks 2.0. Participation has changed. We rebuilt the observatory.">
{# MOCKUP LAYOUT ("Participation is a living system" concept homepage).
   Unindexed, excluded from collections/sitemap by the page's front matter,
   no analytics tag. Loads shell.css (bar + footer, shared with the concept
   Public Thinking pages) and field.css (the homepage itself). Deliberately
   does NOT load style.css: the homepage concept is built from the brand
   tokens and real content only. #}
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#1F4B4C">
<link rel="icon" href="/assets/images/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
<link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/shell.css">
<link rel="stylesheet" href="/assets/css/field.css">
<script>document.documentElement.classList.add('js');</script>
</head>
<body class="field-body{% if bodyClass %} {{ bodyClass }}{% endif %}">
{% include "partials/field-shell-bar.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% if not footerInline %}{% include "partials/field-shell-foot.njk" %}{% endif %}
<script src="/assets/js/nav-toggle.js"></script>
{% for src in extraScripts %}<script src="/assets/js/{{ src }}"></script>{% endfor %}
<script src="/assets/js/field.js"></script>
</body>
</html>
