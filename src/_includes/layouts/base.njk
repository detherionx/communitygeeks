<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} · Communitygeeks</title>
<meta name="description" content="{{ description }}">

<!-- Open Graph -->
<meta property="og:title" content="{{ title }} · Communitygeeks">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="https://communitygeeks.ai{{ page.url }}">
<meta property="og:image" content="https://communitygeeks.ai/assets/images/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:type" content="image/png">
<meta property="og:image:alt" content="Communitygeeks: Participation Research &amp; Advisory">
<link rel="canonical" href="https://communitygeeks.ai{{ page.url }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }} · Communitygeeks">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="https://communitygeeks.ai/assets/images/og-image.png">

<link rel="icon" href="/assets/images/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png">
<link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://communitygeeks.ai/#organization",
  "name": "Communitygeeks",
  "url": "https://communitygeeks.ai/",
  "logo": "https://communitygeeks.ai/assets/images/icon.png",
  "description": "Communitygeeks is a participation research and advisory practice founded by Carmelito Bauer. We study how organizations coordinate the people around their products: users, developers, creators, partners, and advocates, and the parts of that work that never got a name at all, and advise based on what the evidence shows, not on where community happens to sit on an org chart.",
  "legalName": "Liebe zur Freiheit LLC",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "30 N Gould St Ste 24310",
    "addressLocality": "Sheridan",
    "addressRegion": "WY",
    "postalCode": "82801",
    "addressCountry": "US"
  },
  "founder": { "@id": "https://communitygeeks.ai/about/#founder" }
}
</script>
{% for line in extraHead %}{{ line | safe }}{% endfor %}

<!-- Analytics: Umami Cloud, one property covering all three mirrored domains.
     data-auto-pageview is off because src/assets/js/analytics.js sends the
     pageview itself, merging in data-artifact-* metadata where present,
     see that file for what it reads and HANDOFF.md/analytics audit for why. -->
<script defer src="{{ analytics.scriptSrc }}" data-website-id="{{ analytics.websiteId }}" data-domains="{{ analytics.domains | join(',') }}" data-auto-pageview="false"></script>
<script defer src="/assets/js/analytics.js"></script>
</head>
<body>

{% include "partials/nav.njk" %}

<main id="main-content">
{{ content | safe }}
</main>

{% if closingCta %}{% include "partials/closing-cta.njk" %}{% endif %}
{% include "partials/footer.njk" %}

<script src="/assets/js/nav-toggle.js"></script>
{% for src in extraScripts %}<script src="/assets/js/{{ src }}"></script>{% endfor %}
</body>
</html>
