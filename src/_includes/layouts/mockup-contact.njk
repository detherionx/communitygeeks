<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} · Communitygeeks</title>
<meta name="description" content="{{ description }}">
{# MOCKUP LAYOUT for the Contact "docking clearance" concept (approved R-03,
   R-04, R-06, R-07; backend decision C-1). Shares shell.css with the concept
   pages; contact.css and contact.js are the page's own. Unindexed, excluded
   from collections, no analytics tag. #}
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#1F4B4C">
<link rel="icon" href="/assets/images/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
<link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/shell.css">
<link rel="stylesheet" href="/assets/css/contact.css">
<script>document.documentElement.classList.add('js');</script>
</head>
<body class="contact-body">
{% include "partials/field-shell-bar.njk" %}
<main id="main">
{{ content | safe }}
</main>
<script src="/assets/js/nav-toggle.js"></script>
<script src="/assets/js/contact.js" defer></script>
</body>
</html>
