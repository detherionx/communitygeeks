<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
{% include "partials/head.njk" %}
{# HOMEPAGE LAYOUT ("Participation is a living system", production since 2026-09-03). shell.css carries the bar and
   footer shared with every page; field.css is the homepage's own system. It deliberately does not load style.css:
   the homepage is built from the brand tokens and real content only. #}
<link rel="stylesheet" href="/assets/css/shell.css?v=decision-framed-5">
<link rel="stylesheet" href="/assets/css/field.css?v=decision-framed-5">
<link rel="stylesheet" href="/assets/css/hero-clarity.css?v=decision-framed-5">
