      <div class="close-actions">
        <a href="/mockups/field/contact/" class="kctl"><span class="kctl-rule" aria-hidden="true"></span><span class="kctl-row"><span class="kctl-label">Compare notes</span><span class="kctl-mark" aria-hidden="true"></span></span></a>
        <p class="close-mail-row"><span>Direct, no form required if you&rsquo;d rather just write:</span><a href="mailto:carmelito@communitygeeks.de" class="close-mail">carmelito@communitygeeks.de</a></p>
        <a href="/mockups/field/public-thinking/" class="close-secondary">Read the research →</a>
      </div>
    </div>
  </div>
  {% set inline = true %}{% include "partials/field-shell-foot.njk" %}
</section>
