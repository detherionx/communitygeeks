{# =========================================================================
   CONCEPT: PARTICIPATION IS A LIVING SYSTEM, refinement pass 2.
   One SVG "field map" engine (field.js). The System sequence is the page's
   single scroll-controlled reveal; the hero connects itself on load, the
   questions are a compact instrument, the approach path draws once on
   entry. All copy is existing approved text (homepage, Approach, About,
   Contact, published Field Notes), reordered and occasionally shortened;
   nothing is invented.
   ========================================================================= #}

{# ---------------------------------------------------------------- HERO #}
<section class="hero chapter" id="field" data-chapter="01" data-title="Field">
  <div class="hero-pin">
    <div class="layer layer-topo" aria-hidden="true">
      <svg class="topo" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
        <path d="M-40,620 C180,560 300,700 520,640 S900,520 1120,610 S1380,700 1500,640"/>
        <path d="M-40,700 C200,640 340,790 560,720 S920,600 1140,700 S1390,790 1500,720"/>
        <path d="M-40,540 C160,480 320,610 540,560 S880,440 1100,530 S1370,610 1500,560"/>
        <path d="M-40,460 C150,410 330,520 550,480 S870,370 1090,450 S1360,520 1500,480"/>
        <path class="topo-fore" d="M600,-20 C640,120 560,260 640,400 S760,600 700,760 S640,900 680,940"/>
        <path class="topo-fore" d="M980,-20 C1020,140 940,300 1010,440 S1120,640 1060,800 S1000,900 1040,940"/>
      </svg>
    </div>
    <div class="layer layer-map" aria-hidden="true">
      <svg class="field-svg" id="hero-field" viewBox="0 0 1000 620" preserveAspectRatio="xMidYMid meet"></svg>
    </div>
    <div class="layer layer-ui">
      <p class="hero-readout"><span class="node-dot node-dot-ochre"></span><span>Participation Research &amp; Advisory</span></p>
      <h1 class="hero-h1">
        <span class="h1-line"><span>Participation rarely fits</span></span>
        <span class="h1-line"><span>neatly into an org chart.</span></span>
      </h1>
      <p class="hero-sub">We study what happens around products: how people <em data-verb="gather">gather</em>, <em data-verb="contribute">contribute</em>, <em data-verb="connect">connect</em> and <em data-verb="create">create value</em>.</p>
      <div class="hero-controls">
        <a href="/mockups/field/contact/" class="kctl"><span class="kctl-rule" aria-hidden="true"></span><span class="kctl-row"><span class="kctl-label">Compare notes</span><span class="kctl-mark" aria-hidden="true"></span></span></a>
        <a href="/mockups/field/public-thinking/" class="kctl kctl-secondary"><span class="kctl-row"><span class="kctl-label">Read the research</span><span class="kctl-mark" aria-hidden="true"></span></span></a>
      </div>
      <p class="hero-for">For leadership deciding how to invest in community, DevRel, or partnerships.</p>
    </div>
    <div class="layer layer-fore" aria-hidden="true">
      <span class="tick tick-tl"></span><span class="tick tick-tr"></span><span class="tick tick-bl"></span><span class="tick tick-br"></span>
    </div>
  </div>
</section>

{# ---------------------------------------------------------- TRUST RAIL #}
<section class="trust" aria-labelledby="trust-label">
  <p class="trust-label" id="trust-label">Trusted by industry leaders</p>
  <div class="rail">
    <ul class="rail-track">
      {% for item in clients.logoWall %}
      <li class="logo" tabindex="0" role="img" aria-label="{{ item.name }}" style="--logo-url:url('{{ item.logoPath }}');"><span class="logo-mask"></span><span class="logo-name">{{ item.name }}</span></li>
      {% endfor %}
      {% for copy in [1, 2] %}{% for item in clients.logoWall %}
      <li class="logo" aria-hidden="true" style="--logo-url:url('{{ item.logoPath }}');"><span class="logo-mask"></span></li>
      {% endfor %}{% endfor %}
    </ul>
  </div>
</section>

{# ----------------------------------------------------- PINNED NARRATIVE #}
<section class="narrative chapter" id="system" data-chapter="02" data-title="System" data-stage="0">
  <div class="nar-pin">
    <div class="nar-stage">
    <p class="nar-caption" id="nar-caption" aria-hidden="true"></p>
    {# System sequence, orbital vocabulary (approved A-11, Study D): geometry
       in the SVG, every label in the HTML layer beside it, both sized by the
       same box so coordinates map one to one. #}
    <div class="nar-box">
      <svg class="field-svg ob-svg" id="nar-field" viewBox="0 0 1000 620" preserveAspectRatio="xMidYMid meet" aria-hidden="true"></svg>
      <div class="nar-labels" id="nar-labels" aria-hidden="true"></div>
    </div>
    <div class="nar-hud" aria-hidden="true">
      <span class="nar-stage-num"><b id="nar-num">01</b> / 06</span>
      <ol class="nar-stage-list">
        <li>Three channels, no coordination</li>
        <li>Many participant groups, overlapping</li>
        <li>Ownership unclear</li>
        <li>The system mapped</li>
        <li>Relationships legible</li>
        <li>Participation as value</li>
      </ol>
    </div>
    </div>
    <div class="nar-notes">
      <article class="note" data-note="0">
        <span class="note-kicker">System view 01 · The old container</span>
        <p class="note-lead">A forum. A Discord server. An engagement calendar.</p>
        <p>That used to be enough to call something &ldquo;community.&rdquo;</p>
      </article>
      <article class="note" data-note="1">
        <span class="note-kicker">System view 02 · Many groups at once</span>
        <p class="note-lead">Most organizations coordinate many participant groups at once: users, developers, creators, partners, advocates, and others specific to the product.</p>
        <p class="note-tags"><span>users</span><span>developers</span><span>creators</span><span>partners</span><span>advocates</span><span class="note-tag-open">and others …</span></p>
      </article>
      <article class="note" data-note="2">
        <span class="note-kicker">System view 03 · Nobody owns the overlap</span>
        <p class="note-lead">Often without anyone owning how those groups relate to each other, or what happens where they overlap.</p>
        <p class="note-q">What&rsquo;s owned internally versus externally?</p>
      </article>
      <article class="note" data-note="3">
        <span class="note-kicker">System view 04 · Diagnostics</span>
        <p class="note-lead">Mapping who actually participates around your product, where value gets created, and where it breaks down, before recommending any structure.</p>
        <p class="note-verbs"><span class="on">Identify.</span> <span>Understand.</span> <span>Shape.</span> <span>Strengthen.</span></p>
      </article>
      <article class="note" data-note="4">
        <span class="note-kicker">System view 05 · The question changes</span>
        <p class="note-lead">Not <s>where does your community run</s>, but who&rsquo;s actually participating, and how.</p>
        <p class="note-verbs"><span>Identify.</span> <span class="on">Understand.</span> <span class="on">Shape.</span> <span>Strengthen.</span></p>
      </article>
      <article class="note" data-note="5">
        <span class="note-kicker">System view 06 · One connected system</span>
        <p class="note-lead">How people gather, contribute, connect and create value.</p>
        <p>Participation around a product rarely fits one team, channel or program. Neither does the work.</p>
        <a class="note-link" href="#approach">How we work →</a>
      </article>
    </div>
  </div>
  <div class="nar-steps" aria-hidden="true">
    <div class="nar-step"></div><div class="nar-step"></div><div class="nar-step"></div>
    <div class="nar-step"></div><div class="nar-step"></div><div class="nar-step"></div>
  </div>
</section>

{# ------------------------------------------------------ HOW WE WORK PATH #}
<section class="pathway chapter" id="approach" data-chapter="03" data-title="Approach">
  <div class="path-wrap">
    <div class="path-head">
      <p class="kicker"><span class="node-dot node-dot-ochre"></span>How we work</p>
      <h2 class="path-h2">One investigation,<br>not a rate card.</h2>
      <p class="path-bridge">Participation around a product rarely fits one team, channel or program. Neither does the work.</p>
      <p class="path-note">These are exploratory categories, not a fixed service catalogue.</p>
      <a class="path-more" href="/approach/">Full approach →</a>
    </div>
    <div class="path-stage">
      {# Approach V2 (approved 2026-09-03, Study D): three modes of work on one
         rising path. Stage names are HTML rows (one for the horizontal
         layout, one positioned over the vertical layout); the drawings are
         generated by field.js drawApproachV2() and hidden from assistive
         technology. Legend and panels below are unchanged. #}
      <ol class="stage-row stage-row-d" aria-label="Three modes of work">
        <li><i>01</i>Diagnostics</li><li><i>02</i>Program design</li><li><i>03</i>Research &amp; advisory</li>
      </ol>
      <svg class="path-svg v2-desktop" id="v2-desktop" viewBox="0 0 960 320" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false"></svg>
      <div class="v2-mobile-wrap">
        <ol class="stage-row stage-row-m" aria-label="Three modes of work">
          <li style="--y:67.5%"><i>01</i>Diagnostics</li><li style="--y:40.7%"><i>02</i>Program design</li><li style="--y:13.9%"><i>03</i>Research &amp; advisory</li>
        </ol>
        <svg class="path-svg v2-mobile" id="v2-mobile" viewBox="0 0 390 560" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false"></svg>
      </div>
      {# Process legend: the four verbs of the loop (from the published Field
         Note), in reading order, matched to the loop's ticks clockwise. #}
      <ol class="process-legend" aria-label="The loop: Identify, Understand, Shape, Strengthen">
        <li><span class="pl-idx">01</span><span class="pl-tick" aria-hidden="true"></span><span class="pl-word">Identify</span></li>
        <li><span class="pl-idx">02</span><span class="pl-tick" aria-hidden="true"></span><span class="pl-word">Understand</span></li>
        <li><span class="pl-idx">03</span><span class="pl-tick" aria-hidden="true"></span><span class="pl-word">Shape</span></li>
        <li><span class="pl-idx">04</span><span class="pl-tick" aria-hidden="true"></span><span class="pl-word">Strengthen</span></li>
      </ol>
      <ol class="path-panels">
        <li class="path-panel">
          <span class="pp-idx">Stage 01</span>
          <h3>Participation Strategy &amp; Diagnostics</h3>
          <p>Mapping who actually participates around your product, where value gets created, and where it breaks down, before recommending any structure.</p>
          <span class="pp-for">For leadership deciding how to invest in community, DevRel, or partnerships</span>
        </li>
        <li class="path-panel">
          <span class="pp-idx">Stage 02</span>
          <h3>Program Design</h3>
          <p>Community, developer relations (DevRel), and partnership programs, designed around the specific groups your product actually has, not a template org chart.</p>
          <span class="pp-for">For teams building or restructuring a community, DevRel, or partner function</span>
        </li>
        <li class="path-panel">
          <span class="pp-idx">Stage 03</span>
          <h3>Research &amp; Advisory</h3>
          <p>Ongoing, evidence-based advisory grounded in active interviews and pattern-matching across companies, not a one-off audit.</p>
          <span class="pp-for">For organizations wanting a standing research partner, not a single engagement</span>
        </li>
      </ol>
    </div>
  </div>
</section>

{# ------------------------------------------------ QUESTIONS: INSTRUMENT #}
<section class="diagnostic chapter" id="questions" data-chapter="04" data-title="Questions" data-q="0">
  <div class="diag-grid">
    <div class="diag-copy">
      <p class="kicker"><span class="node-dot node-dot-ochre"></span>How Communitygeeks thinks</p>
      <h2 class="diag-h2">Not <s>where does your community run</s>, but who&rsquo;s actually participating, and how.</h2>
      <p class="diag-intro">Every engagement starts from the same set of questions, before any recommendation gets made.</p>
      <ol class="qlist" role="group" aria-label="Diagnostic questions">
        <li><button class="qnode" type="button" data-q="0" aria-pressed="true"><span class="qnode-dot"></span><span class="qnode-idx">01</span><span class="qnode-text">Who participates around your product?</span></button></li>
        <li><button class="qnode" type="button" data-q="1" aria-pressed="false"><span class="qnode-dot"></span><span class="qnode-idx">02</span><span class="qnode-text">What value does each group create?</span></button></li>
        <li><button class="qnode" type="button" data-q="2" aria-pressed="false"><span class="qnode-dot"></span><span class="qnode-idx">03</span><span class="qnode-text">Where do those groups actually interact?</span></button></li>
        <li><button class="qnode" type="button" data-q="3" aria-pressed="false"><span class="qnode-dot"></span><span class="qnode-idx">04</span><span class="qnode-text">What&rsquo;s owned internally versus externally?</span></button></li>
        <li><button class="qnode" type="button" data-q="4" aria-pressed="false"><span class="qnode-dot"></span><span class="qnode-idx">05</span><span class="qnode-text">Which relationships matter most right now?</span></button></li>
        <li><button class="qnode" type="button" data-q="5" aria-pressed="false"><span class="qnode-dot"></span><span class="qnode-idx">06</span><span class="qnode-text">Where does participation actually break down?</span></button></li>
      </ol>
    </div>
    <div class="diag-instrument">
      <div class="diag-instrument-head"><span>Participation <span class="diag-head-long">around a product</span></span><span id="diag-q-label">Question 01</span></div>
      {# A Bauhaus orrery, built by field.js: the product at the centre,
         participant groups on offset elliptical orbits, a faint outer orbit
         for groups specific to the product. Each question sets a distinct
         state of the same system. The viewBox holds every state with
         clearance; nothing meaningful is clipped. #}
      <svg class="orrery-svg" id="orrery-field" viewBox="-60 16 800 568" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Orrery instrument: your product at the centre, with users, developers, creators, partners and advocates on offset orbits and a faint outer orbit for other participant groups. Selecting a question changes the state of the instrument."></svg>
      <div class="q-explain" aria-live="polite">
        <div class="q-card" data-q="0"><span class="q-src">Reading · from About</span><p>We begin with the people around a product and the relationships between them, not with the assumption that the answer is another Discord, forum, or community platform.</p></div>
        <div class="q-card" data-q="1"><span class="q-src">Reading · from Approach</span><p>Mapping who actually participates around your product, where value gets created, and where it breaks down, before recommending any structure.</p></div>
        <div class="q-card" data-q="2"><span class="q-src">Reading · Field Note, Aug 2026</span><p>Instead of asking which channels need to be served next, the focus shifts to the interplay between different stakeholders around a company.</p></div>
        <div class="q-card" data-q="3"><span class="q-src">Reading · from Approach</span><p>Where it&rsquo;s owned internally versus externally, and where things break down, before recommending any structure.</p></div>
        <div class="q-card" data-q="4"><span class="q-src">Reading · from About</span><p>Community, DevRel, partnerships, and advocacy increasingly overlap. We look at how participation actually works before recommending where teams, programs, or platforms should sit.</p></div>
        <div class="q-card" data-q="5"><span class="q-src">Reading · Field Note, Sep 2026</span><p>Participation is moving across the boundaries between community, DevRel, marketing, partnerships, product, sales, and executive strategy.</p></div>
      </div>
    </div>
  </div>
</section>

{# --------------------------------------------- SELECTED WORK: VIGNETTES #}
<section class="cases chapter" id="cases" data-chapter="05" data-title="Selected work">
  {# Compact credibility, not a chapter: headline left, one index of six selected
     real engagements right. Order is the data order (DeepL, EU Academy,
     Tencent first); every description is the existing `proof` text. #}
  <div class="exp-grid">
    <div class="exp-head">
      <p class="kicker"><span class="node-dot node-dot-ochre"></span>Selected work</p>
      <h2 class="cases-h2">A decade of building the programs we now research.</h2>
      <p class="cases-lead">Selected engagements across SaaS and AI, the public sector, gaming and FMCG, shown with what was actually done.</p>
    </div>
    <ol class="exp-rows">
      {% for client in clients.selectedWork %}
      <li class="exp-row">
        <span class="exp-logo" role="img" aria-label="{{ client.name }}" title="{{ client.name }}" style="--logo-url:url('{{ client.logoPath }}');"></span>
        <span class="exp-proof">{{ client.proof }}</span>
        <span class="exp-tag">{{ client.tag }}</span>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ------------------------------------------- PUBLIC THINKING: PREVIEW #}
<section class="pt chapter" id="thinking" data-chapter="06" data-title="Public Thinking">
  <div class="pt-head">
    <div>
      <p class="kicker"><span class="node-dot node-dot-ochre"></span>Public Thinking</p>
      <h2 class="pt-h2">Live findings,<br>not a static portfolio.</h2>
    </div>
    <div class="pt-head-side">
      <p class="pt-sub">Research findings, executive one-pagers, case studies, and field notes, in whatever format the finding actually calls for. Each piece is tagged by format and by how much evidence currently supports it.</p>
    </div>
  </div>
  {# Live research signal: a rail along the ledger. On entry the coral trace
     travels down the rail and resolves at the newest finding; hovering or
     focusing a row moves it there; the beacon at the foot marks "See all".
     Decorative only: hidden from assistive technology, static under
     reduced motion. Geometry is measured from the DOM by field.js. #}
  <div class="pt-body" id="pt-body">
    <svg class="pt-signal" id="pt-signal" aria-hidden="true" focusable="false"></svg>
  <ol class="ledger" id="ledger">
    {% for piece in publicThinking %}
    <li class="ledger-row">
      <span class="ledger-date">{{ piece.date | readableDate }}</span>
      <span class="ledger-meta"><span class="entry-format">{{ piece.format }}</span><span class="entry-conf">{{ piece.confidence }}</span></span>
      <div class="ledger-main">
        <h3 class="ledger-title"><a href="/mockups/field{{ piece.url }}">{{ piece.title }}</a></h3>
        {% if piece.deck %}<p class="ledger-deck">{{ piece.deck }}</p>{% endif %}
        <span class="entry-topics">{% for t in piece.topics %}<span>{{ t }}</span>{% endfor %}</span>
      </div>
      <a class="entry-link ledger-link" href="/mockups/field{{ piece.url }}">Read {{ piece.format | lower }} →</a>
    </li>
    {% endfor %}
  </ol>
  <div class="pt-foot">
    {% if publicThinking.length and publicThinking[0].researchThread %}<p class="pt-thread">Currently investigating: {{ publicThinking[0].researchThread }}.</p>{% endif %}
    <a class="kctl kctl-secondary pt-seeall" id="pt-seeall" href="/mockups/field/public-thinking/"><span class="kctl-row"><span class="kctl-label">See all Public Thinking</span><span class="kctl-mark" aria-hidden="true"></span></span></a>
  </div>
  </div>
</section>

{# ------------------------------------------- FOUNDER: warm human surface #}
<section class="founder" id="founder-section" aria-labelledby="founder-name">
  <article class="author-note" id="founder">
    <div class="author-row">
      <figure class="author-fig">
        <img src="/assets/images/founder.jpg" alt="Carmelito Bauer" width="280" height="360" loading="lazy">
        <span class="tick tick-tl"></span><span class="tick tick-br"></span>
      </figure>
      <div>
        <span class="note-kicker">Founder · The person behind the work</span>
        <h3 class="author-name" id="founder-name">Carmelito Bauer</h3>
        <p class="author-role">Founder, Communitygeeks</p>
        <p class="author-bio">Carmelito has spent more than a decade building community, developer, and advocacy programs across SaaS, AI, gaming, and education, including work with DeepL, Tencent, and EU Academy. Today his work focuses on how community, developer relations, partnerships, and ecosystem strategy are evolving.</p>
        <a class="entry-link" href="/about/">About Communitygeeks →</a>
      </div>
    </div>
  </article>
</section>

{# ------------------------------------------------------------- CLOSE #}
<section class="close chapter" id="talk" data-chapter="07" data-title="Talk">
  <div class="close-grid">
    <div>
      <p class="kicker close-kicker"><span class="node-dot node-dot-ochre"></span>Get in touch</p>
