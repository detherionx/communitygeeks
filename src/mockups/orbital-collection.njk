<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Communitygeeks · Orbital article motifs</title><link rel="stylesheet" href="/assets/css/style.css"><style>
body{margin:0;background:#f7f5ef;color:#14383a}main{max-width:1260px;padding:40px 32px 90px;margin:auto}.eyebrow{font:12px 'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.08em}h1{font:44px/1.1 'Fraunces',serif;margin:24px 0}header p{font:18px/1.6 sans-serif;max-width:750px}header a{color:inherit}section{display:grid;grid-template-columns:1fr 1fr;margin-top:44px;gap:1px;background:#d4d8cf;border:1px solid #d4d8cf}article{background:#f7f5ef;padding:28px 34px 36px}article .drawing{max-width:450px;margin:auto}h2{font:27px/1.2 'Fraunces',serif;margin:12px 0}article p{font:16px/1.6 sans-serif;color:#496261;min-height:78px}article a{font:13px 'IBM Plex Mono',monospace;color:#14383a}.small{display:flex;align-items:center;gap:22px;border-top:1px solid #d4d8cf;margin-top:22px;padding-top:16px}.small .drawing{width:200px;flex-shrink:0;margin:0}.small span{font:12px/1.6 'IBM Plex Mono',monospace;color:#61746f}@media(max-width:720px){main{padding:24px 18px}section{grid-template-columns:1fr}article{padding:20px}.small .drawing{width:170px}h1{font-size:35px}}
.glow-controls{display:flex;gap:10px;margin:24px 0}.glow-controls button{font:14px sans-serif;padding:11px 18px;border:1px solid #8ba49b;background:transparent;color:#14383a;cursor:pointer}.glow-controls button[aria-pressed="true"]{background:#14383a;color:#f7f5ef}.glow-controls button:focus-visible{outline:2px solid #ec765d;outline-offset:3px}body[data-glow="off"] .orbital-aura{display:none}</style></head><body data-glow="on"><main><header><div class="eyebrow">Communitygeeks / canonical orbital direction</div><h1>Constellation ring. Faint galactic aura.</h1><p>A thin constellation ring passes behind and in front of the astronauts, with a softly clouded aura around the ring. The petrol background stays plain. Large and compact sizes shown together.</p><p><a href="/public-thinking/">View the actual article overview →</a></p><div class="glow-controls" role="group" aria-label="Compare aura"><button type="button" data-glow="on" aria-pressed="true">Faint aura</button><button type="button" data-glow="off" aria-pressed="false">Ring only</button></div></header><section>{% for piece in publicThinking %}<article><div class="drawing">{{ piece.motif | constellation('masthead','paper','en') | safe }}</div><h2>{{ piece.title }}</h2><p>{{ notes[piece.motif] }}</p><a href="{{ piece.url }}">View in the article →</a><div class="small"><div class="drawing">{{ piece.motif | constellation('catalogue','paper','en') | safe }}</div><span>COMPACT<br>Same scene.<br>Readable action.</span></div></article>{% endfor %}</section></main><script>document.querySelectorAll("button[data-glow]").forEach(button=>button.addEventListener("click",()=>{document.body.dataset.glow=button.dataset.glow;document.querySelectorAll("button[data-glow]").forEach(b=>b.setAttribute("aria-pressed",String(b===button)))}));</script></body></html>
