{#
  The site's social preview (Communitygeeks 2.0), screenshotted by scripts/generate-og-images.js at 1200x627 into
  _site/assets/images/communitygeeks-2-og-2026.png and then removed from _site like the piece cards. A new filename on
  purpose: LinkedIn and Buffer cache the old asset by URL. Deep teal field, bone type, coral signal, the Reticulum
  geometry from the shared motif renderer. Self-contained: no layout chrome.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex,nofollow">
<title>OG: Communitygeeks 2.0</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
<style>
  .og-site{width:1200px;height:627px;position:relative;overflow:hidden;background:#1F4B4C;color:#F6F4EF;font-family:'Archivo',sans-serif;}
  .og-site .grid{position:absolute;inset:0;background-image:linear-gradient(rgba(246,244,239,0.06) 1px,transparent 1px),linear-gradient(90deg,rgba(246,244,239,0.06) 1px,transparent 1px);background-size:120px 120px;background-position:60px 3px;}
  .og-site .kick{position:absolute;left:84px;top:78px;display:flex;align-items:center;gap:14px;font-family:'IBM Plex Mono',monospace;font-size:20px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#F6F4EF;}
  .og-site .kick i{display:block;width:12px;height:12px;background:#E8735A;}
  .og-site .rule{position:absolute;left:84px;top:128px;width:320px;height:2px;background:#EDE5D3;}
  .og-site h1{position:absolute;left:84px;top:170px;margin:0;font-family:'Fraunces',serif;font-weight:400;font-size:70px;line-height:1.04;letter-spacing:-0.015em;color:#EDE5D3;max-width:640px;}
  .og-site h1 em{font-style:italic;font-weight:300;color:#EDE5D3;} /* style.css paints h1 em petrol; on the teal field it must stay bone */
  .og-site .sig{position:absolute;left:84px;bottom:58px;display:flex;align-items:center;gap:12px;font-family:'IBM Plex Mono',monospace;font-size:18px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(246,244,239,0.7);}
  .og-site .sig b{font-weight:500;color:#F6F4EF;}
  .og-site .motif{position:absolute;right:64px;top:64px;width:480px;height:auto;}
  .og-site .motif .cm-label{display:none;}
  .og-site .axis{position:absolute;left:760px;top:0;bottom:0;width:1px;background:rgba(246,244,239,0.22);}
  .og-site .axis::after{content:"";position:absolute;left:-3px;top:520px;width:7px;height:7px;background:#E8735A;}
</style>
</head>
<body>
<div class="og-site">
  <div class="grid" aria-hidden="true"></div>
  <span class="axis" aria-hidden="true"></span>
  <div class="motif" aria-hidden="true">{{ 'reticulum' | constellation('og', 'dark') | safe }}</div>
  <p class="kick"><i></i>Communitygeeks 2.0</p>
  <div class="rule"></div>
  <h1>Participation has changed.<br><em>We rebuilt the observatory.</em></h1>
  <p class="sig"><b>COMMUNITYGEEKS</b> · Participation research &amp; advisory</p>
</div>
</body>
</html>
