---
pagination:
  data: ogPieces
  size: 1
  alias: piece
eleventyExcludeFromCollections: true
permalink: "/og-cards/{{ piece.slug }}/index.html"
---
{#
  One piece's generated social-card source, screenshotted by
  scripts/generate-og-images.js into
  src/assets/images/public-thinking/og/{{ piece.slug }}.png and then removed
  from the deployed _site output (see that script — these pages exist only
  to be screenshotted, never to be visited). Deliberately not extending
  layouts/base.njk: no nav/footer/other page chrome should ever end up in a
  1200x630 crop, so this is its own minimal document that still loads the
  real stylesheet and the real Google Fonts link, same as every other page.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex,nofollow">
<title>OG card: {{ piece.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
{% from "partials/pt-motifs.njk" import ptMotif %}
<body>
<div class="og-card accent-{{ piece.accentColor or 'petrol' }}">
  {% if piece.motif %}<div class="pt-motif pt-motif--og pt-motif-{{ piece.motif }}" aria-hidden="true">{{ ptMotif(piece.motif) }}</div>{% endif %}

  <div class="og-kicker">
    {% include "partials/node-mark.njk" %}
    <span class="og-kicker-label">Public Thinking &middot; {{ piece.format }}</span>
  </div>
  <div class="og-rule"></div>

  <h1 class="og-headline">{{ piece.title }}</h1>

  {% if piece.deck %}<p class="og-deck">{{ piece.deck }}</p>{% endif %}

  <div class="og-sig">
    {% include "partials/node-mark.njk" %}
    <span class="og-sig-label">COMMUNITYGEEKS</span>
  </div>
</div>
</body>
</html>
