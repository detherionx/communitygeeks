---
pagination:
  data: ogPieces
  size: 1
  alias: piece
eleventyExcludeFromCollections: true
permalink: "/og-cards/{{ piece.slug }}/index.html"
---
{#
  One piece's generated social-card source, screenshotted by
  scripts/generate-og-images.js into
  src/assets/images/public-thinking/og/{{ piece.slug }}.png and then removed
  from the deployed _site output (see that script; these pages exist only
  to be screenshotted, never to be visited). Deliberately not extending
  layouts/base.njk: no nav/footer/other page chrome should ever end up in a
  1200x630 crop, so this is its own minimal document that still loads the
  real stylesheet and the locally hosted fonts, same as every other page.
#}
<!DOCTYPE html>
<html lang="{{ piece.lang or 'en' }}">
<head>
<meta charset="UTF-8">
<link rel="stylesheet" href="/assets/css/fonts.css">
<meta name="robots" content="noindex,nofollow">
<title>OG card: {{ piece.title }}</title>
<link rel="stylesheet" href="/assets/css/style.css">
<style>
  .og-copy{position:absolute;top:154px;left:84px;width:620px;z-index:1;}
  .og-copy .og-headline{position:static;max-width:none;font-size:46px;line-height:1.06;}
  .og-copy .og-deck{position:static;display:block;margin-top:20px;font-size:21px;line-height:1.4;overflow:visible;}
  .og-card .pt-motif--og{width:420px;right:44px;}
</style>
</head>
{% from "partials/pt-motifs.njk" import ptConstellation %}
<body>
<div class="og-card accent-{{ piece.accentColor or 'petrol' }}">
  {% if piece.motif %}<div class="pt-motif pt-motif--og pt-motif-{{ piece.motif }}" aria-hidden="true">{{ ptConstellation(piece.motif, 'og', 'paper') }}</div>{% endif %}

  <div class="og-kicker">
    {% include "partials/node-mark.njk" %}
    <span class="og-kicker-label">{{ 'Artikel' if piece.lang == 'de' else 'Articles' }}</span>
  </div>
  <div class="og-rule"></div>

  <div class="og-copy">
    <h1 class="og-headline">{{ piece.title }}</h1>
    {% if piece.deck %}<p class="og-deck">{{ piece.deck }}</p>{% endif %}
  </div>

  <div class="og-sig">
    {% include "partials/node-mark.njk" %}
    <span class="og-sig-label">COMMUNITYGEEKS</span>
  </div>
</div>
</body>
</html>
