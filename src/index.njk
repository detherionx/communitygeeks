{# Journal: one lead story, three recent article scenes, a slim research band; the archive lives at /public-thinking/. #}
{% set pieces = publicThinking %}
{% set lead = pieces[0] %}
{% set topicLabel = {'community-management-participation-strategy': 'Community & adoption', 'what-remains-human-when-ai-takes-over': 'AI & human judgment', 'ai-coding-agents-systems-builders': 'AI & systems'} %}
<section class="jm" data-editorial id="thinking" aria-labelledby="jm-title">
  <svg class="journal-stars" data-researcher='{"part":"bg"}' aria-hidden="true" focusable="false"></svg>

  <header class="jm-head">
    <div class="jm-head-copy">
      <p class="kicker">The journal</p>
      <h2 id="jm-title">What we are learning.</h2>
      <p>Field notes and research on builder ecosystems. Each piece is labelled Observation, Emerging Pattern or Research Finding to distinguish early thinking from stronger evidence.</p>
      <a class="text-link" href="/public-thinking/">Browse all articles <span aria-hidden="true">→</span></a>
    </div>
    <div class="jm-journal">{% include "partials/journal-astronaut.njk" %}</div>
  </header>

  <div class="jm-front">
    <article class="jm-lead">
      <figure class="jm-lead-figure">
        <a class="jm-lead-media" href="{{ lead.url }}" tabindex="-1" aria-hidden="true">
          <img src="{{ lead.homepageImage or lead.editorialImage.src }}" alt="" loading="lazy" style="object-position:{{ lead.editorialImage.focus }}">
          <span class="jm-obs">Obs. {{ lead.obs }}</span>
        </a>
        {% if lead.homepageCaption %}<figcaption class="jm-lead-cap">From the essay · {{ lead.homepageCaption }}</figcaption>{% endif %}
      </figure>
      <div class="jm-lead-body">
        <span class="jm-lead-geo" aria-hidden="true"><span class="geo-disc"></span><span class="geo-ring"></span><span class="geo-square"></span><span class="geo-rule"></span></span>
        <p class="jm-meta"><span>Field note</span><time datetime="{{ lead.date | isoDate }}">{{ lead.date | readableDate }}</time></p>
        <h3><a href="{{ lead.url }}">{{ lead.title }}</a></h3>
        <p class="jm-deck">{{ lead.deck }}</p>
        <a class="text-link" href="{{ lead.url }}">Read the field note <span aria-hidden="true">→</span></a>
      </div>
    </article>

  </div>

  <p class="journal-swipe-hint" aria-hidden="true">Swipe field notes →</p>
  <ol class="jm-shelf" tabindex="0" aria-label="More field notes; scroll horizontally on mobile">
    {% for piece in pieces %}{% if loop.index > 1 and loop.index <= 4 %}
    <li class="jm-card"><article>
      <span class="jm-card-image" aria-hidden="true"><img src="{{ piece.homepageImage or piece.editorialImage.src }}" alt="" loading="lazy"></span>
      <p class="jm-card-obs">Obs. {{ piece.obs }}</p>
      <h3 class="jm-card-title"><a class="jm-card-link" href="{{ piece.url }}">{{ piece.title }}</a></h3>
      <p class="jm-meta"><time datetime="{{ piece.date | isoDate }}">{{ piece.date | readableDate }}</time><span>{{ topicLabel[piece.slug] or piece.topics[0] }}</span></p>
    </article></li>
    {% endif %}{% endfor %}
  </ol>

  <aside class="jm-research" aria-labelledby="jm-research-title">
    <span class="jm-research-geo" aria-hidden="true"><span class="geo-disc"></span><span class="geo-ring"></span><span class="geo-square"></span></span>
    <p class="jm-research-label">Research in progress</p>
    <div>
      <h3 id="jm-research-title">When participant knowledge enters AI answers</h3>
      <p>In our ChatGPT pilot, three Zendesk answers cited only official pages. In one matched Freshdesk answer, 9 of 15 citations came from community threads.</p><small>Four answers, collected 24 August 2026. An initial comparison, not a general ranking.</small>
    </div>
    <a class="text-link" href="/public-thinking/#research">Follow the research <span aria-hidden="true">→</span></a>
  </aside>
</section>
