<section class="recognition-section practice-section" data-editorial id="practice" aria-labelledby="practice-title">
  <header class="section-head practice-head">
    <p class="kicker">From our research</p>
    <h2 id="practice-title">How leading teams run these programmes.</h2>
    <p>Four public programmes we have studied, and what each one shows.</p>
  </header>
  <div class="practice-list">
    <div class="practice-col">
    <details class="practice-item practice-cohort">
      <summary><span class="practice-glyph" aria-hidden="true"></span><span class="practice-co">Zed</span><span class="practice-name">Zed Guild</span><span class="practice-kind">A contributor cohort</span></summary>
      <div class="practice-body"><p>Hundreds applied and Zed invited about a quarter. Contributors move through tracks as their skills grow, from reproducing bugs to shipping features. Zed’s own lesson: go deep, not wide, and don’t let your team become the bottleneck.</p><a class="text-link" href="https://zed.dev/blog/zed-guild-retrospective" target="_blank" rel="noopener">Zed’s retrospective <span aria-hidden="true">↗</span></a></div>
    </details>
    <details class="practice-item practice-advocate">
      <summary><span class="practice-glyph" aria-hidden="true"></span><span class="practice-co">Nebius</span><span class="practice-name">Nebius Fellows</span><span class="practice-kind">Curated advocates</span></summary>
      <div class="practice-body"><p>Fellows host meetups, write tutorials, build open source on Nebius and share product feedback. In return they get early access, credits, work with the DevRel team and direct access to the people building the platform. Both sides of the exchange are written down.</p><a class="text-link" href="https://nebius.com/fellows" target="_blank" rel="noopener">Nebius Fellows <span aria-hidden="true">↗</span></a></div>
    </details>
    </div>
    <div class="practice-col">
    <details class="practice-item practice-advocate">
      <summary><span class="practice-glyph" aria-hidden="true"></span><span class="practice-co">Anthropic</span><span class="practice-name">Claude Community Ambassadors</span><span class="practice-kind">Local organisers</span></summary>
      <div class="practice-body"><p>Ambassadors host meetups, workshops and hackathons. Anthropic covers event funding, ready-to-use content, swag, promotion and API credits. There is no fee, and membership lasts as long as they keep hosting.</p><a class="text-link" href="https://claude.com/community/ambassadors" target="_blank" rel="noopener">The ambassador programme <span aria-hidden="true">↗</span></a></div>
    </details>
    <details class="practice-item practice-route">
      <summary><span class="practice-glyph" aria-hidden="true"></span><span class="practice-co">Fireworks AI</span><span class="practice-name">Developer partners</span><span class="practice-kind">An integration route</span></summary>
      <div class="practice-body"><p>Tool builders show their integration works, document it from a template and apply. Approved integrations are published in the Fireworks docs and promoted through official channels, so builders know exactly how their work reaches users.</p><a class="text-link" href="https://docs.fireworks.ai/ecosystem/integrations_process" target="_blank" rel="noopener">The integration process <span aria-hidden="true">↗</span></a></div>
    </details>
    </div>
  </div>
</section>
{# Journal: one lead story, three recent article scenes, a slim research band; the archive lives at /public-thinking/. #}
{% set pieces = publicThinking %}
{% set lead = pieces[0] %}
{% set topicLabel = {'community-management-participation-strategy': 'Community & adoption', 'what-remains-human-when-ai-takes-over': 'AI & human judgment', 'ai-coding-agents-systems-builders': 'AI & systems'} %}
<section class="jm" data-editorial id="thinking" aria-labelledby="jm-title">
  <svg class="journal-stars" data-researcher='{"part":"bg"}' aria-hidden="true" focusable="false"></svg>

  <header class="jm-head">
    <div class="jm-head-copy">
      <p class="kicker">The journal</p>
      <h2 id="jm-title">The thesis, tested in public.</h2>
      <p>Field notes and research on how companies build with their developers, creators and partners.</p>
      <a class="text-link" href="/public-thinking/">Browse all articles <span aria-hidden="true">→</span></a>
    </div>
    <div class="jm-journal">{% include "partials/journal-astronaut.njk" %}</div>
  </header>

  <div class="jm-front">
    <article class="jm-lead">
      <figure class="jm-lead-figure">
        <a class="jm-lead-media" href="{{ lead.url }}" tabindex="-1" aria-hidden="true">
          <img src="{{ lead.homepageImage or lead.editorialImage.src }}" alt="" loading="lazy" style="object-position:{{ lead.editorialImage.focus }}">
          <span class="jm-obs">Obs. {{ lead.obs }}</span>
        </a>
        {% if lead.homepageCaption %}<figcaption class="jm-lead-cap">From the essay · {{ lead.homepageCaption }}</figcaption>{% endif %}
      </figure>
      <div class="jm-lead-body">
        <span class="jm-lead-geo" aria-hidden="true"><span class="geo-disc"></span><span class="geo-ring"></span><span class="geo-square"></span><span class="geo-rule"></span></span>
        <p class="jm-meta"><span class="jm-tag">Latest</span><span>Field note</span><time datetime="{{ lead.date | isoDate }}">{{ lead.date | readableDate }}</time></p>
        <h3><a href="{{ lead.url }}">{{ lead.title }}</a></h3>
        <p class="jm-deck">{{ lead.deck }}</p>
        <span class="text-link jm-lead-cta" aria-hidden="true">Read the field note <span>→</span></span>
      </div>
    </article>

  </div>

  <p class="jm-shelf-label" id="jm-shelf-label">Earlier field notes</p>
  <ol class="jm-shelf" aria-labelledby="jm-shelf-label">
    {% for piece in pieces %}{% if loop.index > 1 and loop.index <= 4 %}
    <li class="jm-card"><article>
      <span class="jm-card-image" aria-hidden="true"><img src="{{ piece.homepageImage or piece.editorialImage.src }}" alt="" loading="lazy"><span class="jm-card-obs">Obs. {{ piece.obs }}</span></span>
      <span class="jm-card-band" aria-hidden="true"></span>
      <div class="jm-card-body">
        <h3 class="jm-card-title"><a class="jm-card-link" href="{{ piece.url }}">{{ piece.title }}</a></h3>
        <p class="jm-card-sum">{{ piece.deck or piece.summary }}</p>
        <p class="jm-meta"><time datetime="{{ piece.date | isoDate }}">{{ piece.date | readableDate }}</time><span>{{ topicLabel[piece.slug] or piece.topics[0] }}</span></p>
      </div>
    </article></li>
    {% endif %}{% endfor %}
  </ol>

  <aside class="jm-research" aria-labelledby="jm-research-title">
    <span class="jm-research-geo" aria-hidden="true"><span class="geo-disc"></span><span class="geo-ring"></span><span class="geo-square"></span></span>
    <p class="jm-research-label">Research in progress</p>
    <div>
      <h3 id="jm-research-title">How AI companies support their builders</h3>
      <p>We have recorded 722 programme mechanisms across 214 AI companies from public sources, so our recommendations start from what companies actually run.</p>
    </div>
    <a class="text-link" href="/public-thinking/builder-ecosystems/">Read The End of the Line <span aria-hidden="true">→</span></a>
  </aside>
</section>
